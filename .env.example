# ── Google Apps Script 後端 ──
# 部署 gas/Code.gs 後取得的 Web App URL
# 留空則僅使用 localStorage（同瀏覽器跨分頁同步）
VITE_GAS_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# ── Google OAuth（管理員登入）──
# Google Cloud Console > APIs & Credentials > OAuth 2.0 Client ID
# Authorized JavaScript origins: http://localhost:5173 和您的活動主機 URL
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# 允許登入管理後台的 Google 帳號
# 留空則任何 Google 帳號皆可登入
VITE_ADMIN_EMAIL=admin@example.com
